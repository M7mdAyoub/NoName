APP_ENV=development
DATABASE_PATH=./data/app.db
FILES_PATH=./data/files
BACKUP_PATH=./data/backups
SECRET_KEY=change-me                  # JWT signing
IDENTITY_HMAC_KEY=change-me           # hashing of national IDs; never rotate without a re-hash plan
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_DIST=outputs/impactos-frontend/dist  # built frontend, served at /app/
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Language model -------------------------------------------------------------------------
# With LLM_BASE_URL empty the app runs on its built-in rules (no model needed): fine for trying
# everything out. To use Qwen3.5 on vLLM, start it with scripts/serve_vllm.sh (docs/VLLM.md), then
# set LLM_BASE_URL (e.g. http://localhost:8001/v1, or http://<gpu-server>:8001/v1) and check the
# connection with: python scripts/check_llm.py
LLM_MODE=auto                         # auto | mock | real; auto uses the mock when LLM_BASE_URL is empty
LLM_BASE_URL=
LLM_API_KEY=not-needed-for-local      # the --api-key given to vLLM, if any
LLM_MODEL_EXTRACT=qwen3.5             # vLLM's --served-model-name (serve_vllm.sh uses qwen3.5)
LLM_MODEL_FAST=
LLM_MODEL_VISION=                     # optional, OCR of scanned pages
# Qwen3.5 thinks before answering by default; the app needs short JSON answers, so turn it off.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_STRICT_SCHEMA=false               # true for Groq (see docs/VLLM.md, "Hosted instead")
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=180
LLM_IS_EXTERNAL=false                 # true shows the data-boundary warning
UPLOAD_MAX_MB=25
